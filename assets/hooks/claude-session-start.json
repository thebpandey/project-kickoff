{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "'/ABSOLUTE/PYTHON3' '/ABSOLUTE/SKILL/PATH/scripts/load_context.py' --project-root '/ABSOLUTE/PROJECT/ROOT'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "'/ABSOLUTE/PYTHON3' '/ABSOLUTE/SKILL/PATH/scripts/guard_edits.py' --project-root '/ABSOLUTE/PROJECT/ROOT' --host claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "'/ABSOLUTE/PYTHON3' '/ABSOLUTE/SKILL/PATH/scripts/check_checkpoint.py' --project-root '/ABSOLUTE/PROJECT/ROOT' --host claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
